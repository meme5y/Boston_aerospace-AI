# Boston Aerospace AI — configuracao de ambiente
# Copie para .env e preencha os valores.

SECRET_KEY=troque_isto_em_producao

# ---------------------------------------------------------------------------
# Assistente IA — modo OpenAI (usado no lancamento do contest)
# Web Search, RAG interno (opcional) e resposta estruturada via
# Core/AI_Orchestrator.py + OpenAI Responses API.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Modelos GPT-5.6 verificados (lancados 09/07/2026):
#   gpt-5.6-sol    -> flagship, melhor para raciocinio tecnico complexo (mais caro)
#   gpt-5.6-terra  -> equilibrio custo/qualidade (recomendado para uso geral)
#   gpt-5.6-luna   -> mais barato/rapido, para alto volume
#   gpt-5.6        -> alias de "gpt-5.6-sol"
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# [Opcional / nao usado nas rotas atuais] Modo Ollama local — ver Core/RAG.py.
# Mantido para uma eventual oferta futura "modo offline" a clientes com dados
# sensiveis ou conectividade limitada.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
EMBED_MODEL=nomic-embed-text
